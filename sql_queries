-- ✅ Join query
SELECT e.employee_id, e.name, e.department, e.position, p.quarter, p.year,
       p.productivity_score, p.quality_score, p.teamwork_score, p.manager_comments
FROM employees e
JOIN performance_reviews p ON e.employee_id = p.employee_id
ORDER BY e.employee_id;
