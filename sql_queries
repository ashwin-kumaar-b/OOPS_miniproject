-- ✅ Disable safe mode for full cleanup
SET SQL_SAFE_UPDATES = 0;

-- 🧩 Drop existing tables (clean start)
DROP TABLE IF EXISTS performance_reviews;
DROP TABLE IF EXISTS employees;

-- ✅ Re-enable safe updates (optional)
SET SQL_SAFE_UPDATES = 1;

-- ✅ Create database and use it
CREATE DATABASE IF NOT EXISTS employeetracker;
USE employeetracker;

-- ✅ Create employees table
CREATE TABLE employees (
    employee_id VARCHAR(10) PRIMARY KEY,
    name VARCHAR(50) NOT NULL,
    department VARCHAR(50) NOT NULL,
    position VARCHAR(50) NOT NULL,
    base_salary DOUBLE NOT NULL
);

-- ✅ Create performance_reviews table
CREATE TABLE performance_reviews (
    review_id VARCHAR(10) PRIMARY KEY,
    employee_id VARCHAR(10) NOT NULL,
    quarter INT NOT NULL,
    year INT NOT NULL,
    productivity_score DOUBLE NOT NULL,
    quality_score DOUBLE NOT NULL,
    teamwork_score DOUBLE NOT NULL,
    manager_comments VARCHAR(255),
    FOREIGN KEY (employee_id) REFERENCES employees(employee_id)
);

